# Kavach Platform — on-prem configuration (ADR-0017).
# Copy to .env and set real secrets before `docker compose up`.
# All application variables are prefixed KAVACH_.

# --- Postgres ---
POSTGRES_USER=kavach
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=kavach
DB_PORT=5432

# --- Service ports (host side) ---
API_PORT=8000
CONSOLE_PORT=8080

# --- Substrate secrets (REQUIRED — generate strong random values) ---
# e.g. openssl rand -hex 32
KAVACH_AUDIT_HMAC_KEY=change-me-audit-hmac-key
KAVACH_JWT_SECRET=change-me-jwt-secret
KAVACH_OPERATOR_TOKEN=change-me-operator-token

# --- Identity bridge (ADR-0015) ---
# fake     = offline deterministic verifier (no Pramana SDK required)
# pramana  = real Pramana SDK (requires the [pramana] extra / vendored wheel)
KAVACH_SDK_BRIDGE_MODE=fake
KAVACH_EXPECTED_AUDIENCE=kavach

# --- Schema management ---
# false = manage schema with Alembic explicitly (recommended on-prem):
#         docker compose run --rm api alembic upgrade head
# true  = create tables on API startup (convenient for quick demos)
KAVACH_AUTO_CREATE_SCHEMA=false
