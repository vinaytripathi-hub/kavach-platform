# Auto-detect text files and perform LF normalization
* text=auto

# Source files
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Exclude from language stats on GitHub
docs/* linguist-documentation=true
tests/fixtures/* linguist-vendored=true
