{
  "realm": "kavach",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "operator" },
      { "name": "auditor" },
      { "name": "admin" }
    ]
  },
  "clients": [
    {
      "clientId": "kavach",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8080/*"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "kavach",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "change-me-operator", "temporary": false }
      ],
      "realmRoles": ["admin"],
      "attributes": { "tenant": ["bank-1"] }
    }
  ]
}
